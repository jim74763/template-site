# Required: Postgres connection string used by Drizzle and generated lead sites.
# Use your local Postgres URL or a hosted Postgres/Neon URL with SSL parameters if required.
DATABASE_URL=postgres://user:password@localhost:5432/template_site

# Required: Instantly API v2 key (Settings > Integrations > API keys).
INSTANTLY_API_KEY=

# Required: OpenRouter key and model used to write the site copy.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k3
